{
  "name": "clickthrough",
  "version": "0.2.1",
  "description": "Review a product flow screen by screen: click any component, leave a comment, and let your coding agent make the change.",
  "type": "module",
  "bin": { "clickthrough": "bin/cli.mjs", "flow-reviews": "bin/cli.mjs" },
  "files": ["bin", "src", "ui", "capture", "examples", "AGENTS.md", "README.md", "CHANGELOG.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node bin/cli.mjs serve --dir examples",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": ["design-review", "ux", "screenshots", "coding-agent", "claude-code", "codex", "t3"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/S4M3R/clickthrough.git" },
  "homepage": "https://clickthrough.agustin.build",
  "bugs": { "url": "https://github.com/S4M3R/clickthrough/issues" }
}
